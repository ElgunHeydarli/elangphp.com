{
    "name": "elang/framework",
    "description": "A PHP framework for explicit APIs, secure accounts, teams, queues, real-time applications, and approachable multilingual documentation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "doctrine/dbal": "^4.3",
        "league/commonmark": "^2.7",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-local": "^3.31",
        "monolog/monolog": "^3.9",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "php-http/guzzle7-adapter": "^1.0",
        "predis/predis": "^3.7",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "spomky-labs/otphp": "^11.5",
        "symfony/cache": "^7.4",
        "symfony/clock": "^7.4",
        "symfony/console": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/validator": "^7.4",
        "twig/twig": "^3.20",
        "vlucas/phpdotenv": "^5.6",
        "web-auth/webauthn-lib": "^5.3.9"
    },
    "require-dev": {
        "ext-zip": "*",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/process": "^7.4",
        "workerman/workerman": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Elang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/elang"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "serve": "@php elang serve",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@composer audit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
