{
    "name": "elang/framework",
    "description": "An approachable PHP framework with explicit conventions, a small application API, and an English documentation platform built with Elang itself.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.3",
        "league/commonmark": "^2.7",
        "monolog/monolog": "^3.9",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/validator": "^7.4",
        "twig/twig": "^3.20",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Elang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/elang"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "serve": "@php elang serve",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@composer audit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
