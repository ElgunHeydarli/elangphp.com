{% extends '@elang/layout.twig' %}{% block content %}{% if mode == 'index' %}<p class="eyebrow">A LITTLE SPACE FOR USEFUL IDEAS</p><div class="toolbar"><h1>A clear point of view.</h1><a class="button" href="/posts/new">Write your first article →</a></div><div class="account-grid">{% for post in posts %}<article class="panel"><p class="form-hint">{{ post.created_at|date('F j, Y') }}</p><h2><a href="/posts/{{ post.id }}">{{ post.title }}</a></h2><p>{{ post.body|slice(0,180) }}{% if post.body|length > 180 %}…{% endif %}</p><a class="sub-link" href="/posts/{{ post.id }}">Read article →</a>{% if user and user.id == post.author_id %}<a class="sub-link" href="/posts/{{ post.id }}/edit">Edit your article</a>{% endif %}</article>{% else %}<section class="panel"><h2>Your publication starts here.</h2><p>Create an account, verify it in the local development mailbox, and write your first article.</p></section>{% endfor %}</div><div class="toolbar"><span class="form-hint">Page {{ posts.currentPage }} of {{ posts.lastPage }} · {{ posts.total }} articles</span><div class="toolbar-actions">{% if posts.currentPage > 1 %}<a class="button secondary" href="/?page={{ posts.currentPage - 1 }}">← Previous</a>{% endif %}{% if posts.currentPage < posts.lastPage %}<a class="button secondary" href="/?page={{ posts.currentPage + 1 }}">Next →</a>{% endif %}</div></div>
{% elseif mode == 'show' %}<article class="panel"><p class="eyebrow">{{ post.created_at|date('F j, Y') }}</p><h1>{{ post.title }}</h1><div class="post-body">{{ post.body }}</div>{% if user and user.id == post.author_id %}<a class="sub-link" href="/posts/{{ post.id }}/edit">Edit your article →</a>{% endif %}</article><a class="sub-link" href="/">← All articles</a>
{% else %}<p class="eyebrow">YOUR WORDS. YOUR PUBLICATION.</p><h1>{{ title }}</h1>{% if errors %}<div class="notice error" role="alert"><ul>{% for messages in errors %}{% for message in messages %}<li>{{ message }}</li>{% endfor %}{% endfor %}</ul></div>{% endif %}<form class="panel stack" method="post" action="{{ post and post.id ? '/posts/'~post.id : '/posts' }}"><input type="hidden" name="_token" value="{{ token }}"><label>Article title<input name="title" value="{{ post ? post.title : '' }}" required maxlength="160"></label><label>Article text<textarea name="body" required maxlength="20000">{{ post ? post.body : '' }}</textarea></label><label class="checkbox"><input type="checkbox" name="published" value="1"{% if post and post.published %} checked{% endif %}>Publish this article</label><button class="button">Save article →</button></form>{% if post and post.id %}<form method="post" action="/posts/{{ post.id }}/delete"><input type="hidden" name="_token" value="{{ token }}"><button class="button danger">Delete this article</button></form>{% endif %}{% endif %}{% endblock %}
