{% extends '@elang/layout.twig' %}{% block content %}<p class="eyebrow">YOUR SPACE TO MAKE PROGRESS</p><div class="toolbar"><h1>Hello, {{ user.name }}.</h1><a class="button secondary" href="/dashboard">Account settings →</a></div>{% if errors %}<div class="notice error" role="alert"><ul>{% for messages in errors %}{% for error in messages %}<li>{{ error }}</li>{% endfor %}{% endfor %}</ul></div>{% endif %}<div class="stats-grid"><section class="panel stat"><strong>{{ total }}</strong><span>Your notes</span></section><section class="panel stat"><strong>{{ completed }}</strong><span>Completed</span></section><section class="panel stat"><strong>{{ total - completed }}</strong><span>Still ahead</span></section></div><div class="account-grid"><section class="panel"><h2>A useful next step</h2><form action="/workspace/notes" method="post" class="stack"><input type="hidden" name="_token" value="{{ token }}"><label>Title<input name="title" required maxlength="160" placeholder="Build something useful"></label><label>Details<textarea name="body" maxlength="5000"></textarea></label><button class="button">Add a note →</button></form></section><section class="panel"><h2>Your private notes</h2>{% for note in notes %}<article class="list-row"><div><strong>{{ note.completed ? '✓ ' : '' }}{{ note.title }}</strong><p class="form-hint">{{ note.body }}</p><div class="toolbar-actions"><form method="post" action="/workspace/notes/{{ note.id }}/toggle"><input type="hidden" name="_token" value="{{ token }}"><button class="button secondary">{{ note.completed ? 'Mark incomplete' : 'Complete' }}</button></form><form method="post" action="/workspace/notes/{{ note.id }}/delete"><input type="hidden" name="_token" value="{{ token }}"><button class="link-button">Remove</button></form></div></div></article>{% else %}<p class="form-hint">Your first note will appear here. Other users cannot read or change it.</p>{% endfor %}<p class="form-hint">Page {{ notes.currentPage }} of {{ notes.lastPage }}</p><div class="toolbar-actions">{% if notes.currentPage > 1 %}<a href="?page={{ notes.currentPage-1 }}">← Previous</a>{% endif %}{% if notes.currentPage < notes.lastPage %}<a href="?page={{ notes.currentPage+1 }}">Next →</a>{% endif %}</div></section></div>{% endblock %}
