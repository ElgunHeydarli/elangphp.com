{% extends '@elang/layout.twig' %}{% block content %}<p class="eyebrow">A WORKING API. AN EXPLICIT ACCESS MODEL.</p><h1>Your notes, through JSON.</h1><p class="lead">Register, verify your email using the local development mailbox, and create a scoped token in your account. API requests use that bearer token; browser forms keep their session and CSRF protection.</p><div class="toolbar-actions"><a href="/dashboard" class="button">Open your account →</a><a href="/_elang/studio/mail" class="button secondary">Development mailbox</a></div><section class="panel"><h2>Endpoints</h2><div class="table-scroll"><table><thead><tr><th>Method</th><th>Endpoint</th><th>Required scope</th></tr></thead><tbody><tr><td>GET</td><td>/api/notes</td><td>notes:read</td></tr><tr><td>GET</td><td>/api/notes/{id}</td><td>notes:read</td></tr><tr><td>POST</td><td>/api/notes</td><td>notes:write</td></tr><tr><td>PUT</td><td>/api/notes/{id}</td><td>notes:write</td></tr><tr><td>DELETE</td><td>/api/notes/{id}</td><td>notes:write</td></tr></tbody></table></div></section><section class="panel"><h2>Your first request</h2><pre>curl http://127.0.0.1:8000/api/notes \
  -H 'Authorization: Bearer YOUR_TOKEN'</pre><p class="form-hint">Replace YOUR_TOKEN with the one-time value shown after token creation. Keep it private. Records are always restricted to the token owner's account.</p></section>{% endblock %}
