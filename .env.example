APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=
# Official website only; public identifiers, disabled when empty.
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
# SQLite is the default. Keep the database outside the public directory.
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/elang?charset=utf8mb4"
# MAILER_DSN="smtp://user:password@127.0.0.1:587"
MAILER_DSN=null://null
MAIL_FROM=noreply@example.com

# Shared infrastructure (optional; use a private Redis endpoint).
REDIS_URL=
# Enable operational aggregate metrics after platform:setup.
OPERATIONS_ENABLED=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=elang
OTEL_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
FILES_DISK=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PATH_STYLE=false
# Prefer workload identity instead of permanent S3 keys.

# Container secret-file alternative (preserve an existing key):
# APP_KEY_FILE=/run/secrets/elang_app_key
# MAILER_DSN_FILE=/run/secrets/elang_mailer_dsn
