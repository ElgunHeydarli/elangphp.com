<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ description|default('An application built with Elang PHP.') }}"><title>{{ title }} — {{ app_name }}</title><link rel="stylesheet" href="/_elang/assets/ui.css?v={{ elang_asset_version }}">{% if canonical_path is defined %}<link rel="canonical" href="{{ site_url }}{{ canonical_path }}">{% else %}<meta name="robots" content="noindex,follow">{% endif %}</head><body><header class="product-header"><a class="product-brand" href="/">e<span>.</span> <strong>{{ app_name }}</strong></a><nav>{% if app_starter == 'blog' %}<a href="/">Articles</a>{% endif %}{% if user %}{% if app_starter == 'blog' %}<a href="/posts/new">Write</a>{% elseif app_starter == 'dashboard' %}<a href="/workspace">Workspace</a>{% endif %}<a href="/dashboard">Account</a><form action="/logout" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="link-button">Sign out</button></form>{% else %}<a href="/login">Sign in</a><a href="/register">Create account</a>{% endif %}</nav></header><main class="wide-shell">{% block content %}{% endblock %}</main><footer class="product-footer">Built with Elang · <a href="https://elangphp.com/docs/v0.1/introduction">Documentation ↗</a></footer></body></html>
