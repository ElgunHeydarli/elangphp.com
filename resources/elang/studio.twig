<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Elang Studio — Local Development</title><link rel="stylesheet" href="/_elang/assets/ui.css?v={{ elang_asset_version }}"></head><body><header class="product-header"><a class="product-brand" href="/_elang/studio">e<span>.</span> <strong>Elang Studio</strong></a><nav><a href="/">Application ↗</a><span class="badge">LOCAL ONLY</span></nav></header><main class="wide-shell"><p class="eyebrow">UNDERSTAND EVERY STEP</p><h1>Your application, in view.</h1><div class="split-layout"><nav class="side-nav" aria-label="Studio navigation"><a href="/_elang/studio"{% if tab in ['requests','trace'] %} aria-current="page"{% endif %}>Requests & queries</a><a href="/_elang/studio/routes"{% if tab == 'routes' %} aria-current="page"{% endif %}>Routes & middleware</a><a href="/_elang/studio/mail"{% if tab == 'mail' %} aria-current="page"{% endif %}>Development mailbox</a></nav><div>{% if tab == 'requests' %}<section class="panel"><h2>Recent requests</h2><p class="form-hint">Last 100 local requests. Request bodies, cookies, authorization headers, query parameters, and SQL bind values are not recorded.</p><div class="table-scroll"><table><thead><tr><th>Request</th><th>Status</th><th>Duration</th><th>Queries</th></tr></thead><tbody>{% for item in traces %}<tr><td><a href="/_elang/studio/requests/{{ item.id }}">{{ item.method }} {{ item.path }}</a></td><td>{{ item.status }}</td><td>{{ item.milliseconds }} ms</td><td>{{ item.queries|length }}</td></tr>{% else %}<tr><td colspan="4">Open a page in your application, then return here.</td></tr>{% endfor %}</tbody></table></div></section>
{% elseif tab == 'trace' and trace %}<section class="panel"><h2>{{ trace.method }} {{ trace.path }}</h2><div class="stats-grid"><div class="stat"><strong>{{ trace.status }}</strong><span>HTTP status</span></div><div class="stat"><strong>{{ trace.milliseconds }}</strong><span>milliseconds</span></div><div class="stat"><strong>{{ trace.queries|length }}</strong><span>database queries</span></div></div><p class="form-hint">Route: {{ trace.route|default('unnamed') }} · PHP allocator peak: {{ trace.php_memory_bytes }} bytes</p></section>{% if trace.error %}<section class="panel"><h2>Exception location</h2><p>{{ trace.error.type }}</p><pre>{{ trace.error.file }}:{{ trace.error.line }}</pre><p class="form-hint">Inspect the named source location and the private application log. Arguments and exception messages are excluded from Studio to reduce accidental secret capture.</p><div class="table-scroll"><table>{% for frame in trace.error.frames %}<tr><td>{{ frame.file }}:{{ frame.line }}</td><td>{{ frame.call }}</td></tr>{% endfor %}</table></div></section>{% endif %}<section class="panel"><h2>Queries</h2>{% for query in trace.queries %}<p class="form-hint">{{ query.milliseconds }} ms</p><pre>{{ query.sql }}</pre>{% else %}<p>No database queries were recorded.</p>{% endfor %}</section>
{% elseif tab == 'routes' %}<section class="panel"><h2>Registered routes</h2><div class="table-scroll"><table><thead><tr><th>Method</th><th>Path</th><th>Name</th><th>Middleware</th></tr></thead><tbody>{% for route in routes %}<tr><td>{{ route.methods }}</td><td>{{ route.path }}</td><td>{{ route.name }}</td><td>{% for middleware in route.middleware %}<code>{{ middleware }}</code><br>{% endfor %}</td></tr>{% endfor %}</tbody></table></div></section>
{% elseif tab == 'mail' %}<section class="panel"><h2>Development mailbox</h2><p class="form-hint">Local account messages are stored encrypted, outside the public directory. A real mail transport is required for production delivery.</p></section>{% for message in messages %}<section class="panel"><h2>{{ message.subject }}</h2><p class="form-hint">To {{ message.to }} · {{ message.created_at|date('Y-m-d H:i') }}</p><pre>{{ message.body }}</pre></section>{% else %}<section class="panel"><p>No development messages yet. Register an account or request a password reset in your local application.</p></section>{% endfor %}{% endif %}</div></div></main></body></html>
