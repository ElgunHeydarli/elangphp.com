<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,follow"><title>{{ mode == 'dashboard' ? 'Your account' : mode|capitalize }} — {{ app_name }}</title><link rel="stylesheet" href="/_elang/assets/ui.css?v={{ elang_asset_version }}"></head><body><header class="product-header"><a href="/" class="product-brand">e<span>.</span> <strong>{{ app_name }}</strong></a><nav>{% if user %}<a href="/dashboard">Account</a>{% if user.role == 'admin' %}<a href="/admin">Content</a>{% endif %}<form action="/logout" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="link-button">Sign out</button></form>{% else %}<a href="/login">Sign in</a>{% if registration %}<a href="/register">Create account</a>{% endif %}{% endif %}</nav></header><main class="account-shell{% if mode == 'dashboard' %} account-wide{% endif %}"><p class="eyebrow">{{ app_name }} / YOUR ACCOUNT</p>{% set headings = {'login':'Welcome back.','register':'A clear beginning.','forgot':'Recover your account.','reset':'Choose a new password.','password':'Update your password.','dashboard':'Your next chapter.','message':'A small step forward.'} %}<h1>{{ headings[mode]|default('Your account.') }}</h1>{% if message %}<div class="notice" role="status">{{ message }}</div>{% endif %}{% if errors %}<div class="notice error" role="alert"><strong>Please check these details.</strong><ul>{% for field, messages in errors %}{% for error in messages %}<li>{{ error }}</li>{% endfor %}{% endfor %}</ul></div>{% endif %}
{% if mode in ['login','register'] %}<form method="post" action="/{{ mode }}" class="panel stack"><input type="hidden" name="_token" value="{{ token }}">{% if mode == 'register' %}<label>Your name<input name="name" required maxlength="80" autocomplete="name"></label>{% endif %}<label>Email address<input name="email" type="email" required maxlength="190" autocomplete="email"></label><label>Password<input name="password" type="password" required autocomplete="{{ mode == 'login' ? 'current-password' : 'new-password' }}"{% if mode == 'register' %} minlength="12" maxlength="256"{% endif %}></label>{% if mode == 'register' %}<p class="form-hint">Use at least 12 characters. A long, unique passphrase is welcome.</p><label>Confirm password<input name="password_confirmation" type="password" required minlength="12" maxlength="256" autocomplete="new-password"></label>{% endif %}<button class="button">{{ mode == 'login' ? 'Sign in →' : 'Create account →' }}</button></form>{% if mode == 'login' %}<a class="sub-link" href="/forgot-password">Forgot your password?</a>{% if registration %}<a class="sub-link" href="/register">New here? Create an account →</a>{% endif %}{% endif %}
{% elseif mode == 'forgot' %}<p class="lead">Request a one-time recovery link. The same confirmation appears whether or not an account matches.</p>{% if not mail_ready %}<div class="notice">Account email is temporarily unavailable. Contact the site administrator.</div>{% else %}<form method="post" action="/forgot-password" class="panel stack"><input type="hidden" name="_token" value="{{ token }}"><label>Email address<input name="email" type="email" required maxlength="190" autocomplete="email"></label><button class="button">Request recovery link →</button></form>{% endif %}<a class="sub-link" href="/login">← Back to sign in</a>
{% elseif mode in ['reset','password'] %}{% if user and user.mustChangePassword %}<div class="notice">Your account uses a temporary password. Choose a new password before continuing.</div>{% endif %}<form method="post" action="{{ mode == 'reset' ? '/reset-password' : '/password' }}" class="panel stack"><input type="hidden" name="_token" value="{{ token }}">{% if mode == 'reset' %}<input type="hidden" name="token" value="{{ reset_token }}">{% else %}<label>Current password<input type="password" name="current_password" required autocomplete="current-password"></label>{% endif %}<label>New password<input type="password" name="password" required minlength="12" maxlength="256" autocomplete="new-password"></label><p class="form-hint">Use at least 12 characters. Changing the password signs out other sessions and revokes API tokens.</p><label>Confirm new password<input type="password" name="password_confirmation" required minlength="12" maxlength="256" autocomplete="new-password"></label><button class="button">Save new password →</button></form>
{% elseif mode == 'dashboard' and user %}<p class="lead">Hello, {{ user.name }}. Manage your profile and application access.</p><div class="account-grid"><section class="panel stack"><h2>Your profile</h2><p>{{ user.email }} <span class="badge">{{ user.verified ? 'Verified' : 'Not verified' }}</span></p><form action="/profile" method="post" class="stack"><input type="hidden" name="_token" value="{{ token }}"><label>Your name<input name="name" value="{{ user.name }}" required maxlength="80" autocomplete="name"></label><button class="button secondary">Update name</button></form><a class="sub-link" href="/password">Change your password →</a>{% if not user.verified %}<p class="form-hint">Verify your email before using protected publishing features or creating API tokens.</p><form method="post" action="/verify-email"><input type="hidden" name="_token" value="{{ token }}"><button class="button secondary">Send verification link</button></form>{% endif %}{% if local %}<a class="sub-link" href="/_elang/studio/mail">Open the development mailbox ↗</a>{% endif %}</section><section class="panel stack"><h2>API access</h2>{% if new_token %}<div class="notice"><strong>Your new token</strong><p class="secret-value">{{ new_token }}</p><p>Copy it now. It will not be displayed again.</p></div>{% endif %}{% if user.verified %}<form action="/tokens" method="post" class="stack"><input type="hidden" name="_token" value="{{ token }}"><label>Token name<input name="name" required maxlength="80" placeholder="Local development"></label><fieldset><legend>Allowed actions</legend>{% for scope in allowed_scopes %}<label class="checkbox"><input type="checkbox" name="scopes[]" value="{{ scope }}"{% if loop.first %} checked{% endif %}>{{ scope }}</label>{% endfor %}</fieldset><label>Confirm current password<input type="password" name="current_password" required autocomplete="current-password"></label><button class="button">Create token</button></form>{% else %}<p class="form-hint">Email verification is required before issuing tokens.</p>{% endif %}</section></div><section class="panel"><h2>Issued tokens</h2>{% for item in api_tokens %}<div class="list-row"><div><strong>{{ item.name }}</strong><p class="form-hint">Expires {{ item.expires_at|date('Y-m-d') }}</p></div><form method="post" action="/tokens/{{ item.id }}/revoke"><input type="hidden" name="_token" value="{{ token }}"><button class="button secondary">Revoke</button></form></div>{% else %}<p class="form-hint">No API tokens have been issued.</p>{% endfor %}</section>
{% else %}<a class="button" href="{{ user ? '/dashboard' : '/login' }}">{{ user ? 'Open your account' : 'Continue to sign in' }} →</a>{% endif %}</main><footer class="product-footer">Built with Elang · Clear steps. Useful defaults.</footer></body></html>
