{% macro icon(name, size = 20) %}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if name == 'grid' %}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>{% elseif name == 'people' %}<circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m1-17a3 3 0 0 1 0 6m3 11v-3a6 6 0 0 0-2-4"/>{% elseif name == 'file' %}<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6m-12 4h8m-8 4h5"/>{% elseif name == 'inbox' %}<path d="m5 4-3 11v5h20v-5L19 4ZM2 15h6l2 3h4l2-3h6"/>{% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>{% elseif name == 'arrow' %}<path d="m7 17 10-10M7 7h10v10"/>{% elseif name == 'download' %}<path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'lock' %}<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/>{% endif %}</svg>{% endmacro %}
{% import _self as ui %}
{% set role = selected ? selected.role : '' %}
{% set can_write = role in ['owner', 'admin', 'member'] %}
{% set can_manage = role in ['owner', 'admin'] %}
{% set team_path = selected ? '/workspace/team/' ~ selected.id : '/workspace' %}
{% set unread = inbox|filter(item => not item.read_at)|length %}
{% set role_names = {'owner':'Owner','admin':'Administrator','member':'Member','viewer':'Viewer'} %}
{% set status_names = {'planned':'Planned','active':'In progress','done':'Done'} %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>{{ selected ? selected.name ~ ' — ' : '' }}Workspace — {{ app_name }}</title><link rel="stylesheet" href="/_elang/assets/ui.css?v={{ elang_asset_version }}"></head>
<body class="team-workspace">
<header class="product-header"><a href="/workspace" class="product-brand">e<span>.</span> <strong>{{ app_name }}</strong></a><nav aria-label="Account navigation"><a href="/workspace" aria-current="page">Workspace</a><a href="/dashboard">Account</a><a href="/security">Security</a>{% if user.role == 'admin' %}<a href="/operations">Operations</a>{% endif %}<form action="/logout" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="link-button">Sign out</button></form></nav></header>
<div class="ws-layout">
<aside class="ws-sidebar">
  <div class="ws-sidebar-heading"><span class="ws-kicker">YOUR ORGANIZATIONS</span><span class="ws-small-count">{{ teams|length }}</span></div>
  <nav class="ws-team-list" aria-label="Organizations">{% for team in teams %}<a class="ws-team-link{% if selected and selected.id == team.id %} ws-team-selected{% endif %}" href="/workspace/team/{{ team.id|url_encode }}"{% if selected and selected.id == team.id %} aria-current="page"{% endif %}><span class="ws-team-avatar">{{ team.name|slice(0,1)|upper }}</span><span class="ws-team-text"><strong>{{ team.name }}</strong><span>{{ role_names[team.role]|default(team.role) }}</span></span>{{ ui.icon('arrow', 14) }}</a>{% else %}<p class="ws-sidebar-empty">A place for your team starts here.</p>{% endfor %}</nav>
  <details class="ws-create-team"{% if not teams %} open{% endif %}><summary>{{ ui.icon('plus', 16) }}Create organization</summary><form class="stack ws-form" action="/workspace/teams" method="post"><input type="hidden" name="_token" value="{{ token }}"><label>Organization name<input name="name" required maxlength="80" autocomplete="organization" placeholder="Your next chapter"></label><button class="button">Create organization</button></form></details>
  {% if selected %}<nav class="ws-section-nav" aria-label="Workspace sections"><a href="#projects">{{ ui.icon('grid', 18) }}Projects<span>{{ projects|length }}</span></a><a href="#members">{{ ui.icon('people', 18) }}People<span>{{ members|length }}</span></a><a href="#files">{{ ui.icon('file', 18) }}Files<span>{{ files|length }}</span></a><a href="#inbox">{{ ui.icon('inbox', 18) }}Inbox{% if unread %}<span>{{ unread }}</span>{% endif %}</a></nav>{% endif %}
  <div class="ws-sidebar-bottom"><span class="ws-sidebar-symbol">✳</span><p>Clear space.<br><em>Good work.</em></p><div class="ws-user"><span>{{ user.name|slice(0,1)|upper }}</span><div><strong>{{ user.name }}</strong><a href="/security">Account security</a></div></div></div>
</aside>
<main class="ws-main">
  <header class="ws-page-heading"><div><p class="eyebrow">YOUR WORKSPACE / {{ selected ? 'TEAM OVERVIEW' : 'A SHARED BEGINNING' }}</p><h1>{{ selected ? selected.name : 'Room for good work.' }}</h1><p>{{ selected ? 'The projects, people, and files that move your team forward.' : 'Choose an organization, or create a new space for your team.' }}</p></div>{% if selected %}<span class="ws-role-tag">{{ ui.icon('lock', 13) }}{{ role_names[role]|default(role) }}</span>{% endif %}</header>
  {% if message %}<div class="notice" role="status">{{ message }}</div>{% endif %}{% if errors %}<div class="notice error" role="alert"><strong>Please check these details.</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
  {% if invite_url %}<section class="ws-invitation" aria-labelledby="ws-invitation-title"><div><span class="ws-kicker">READY TO SHARE</span><h2 id="ws-invitation-title">A place on your team.</h2><p>Select and copy this private invitation link. Share it only with the invited person.</p></div><label class="sr-only" for="ws-invite-link">Private invitation link</label><input id="ws-invite-link" type="text" readonly value="{{ invite_url }}" autocomplete="off" spellcheck="false"><p class="form-hint">The invited person must sign in with the matching verified email address.</p></section>{% endif %}

  {% if selected %}
  <section class="ws-summary" aria-label="Organization overview"><div><span class="ws-summary-icon">{{ ui.icon('grid', 20) }}</span><span><strong>{{ projects|length }}</strong><span>Projects on the board</span></span></div><div><span class="ws-summary-icon">{{ ui.icon('people', 20) }}</span><span><strong>{{ members|length }}</strong><span>People in your team</span></span></div><div><span class="ws-summary-icon">{{ ui.icon('file', 20) }}</span><span><strong>{{ files|length }}</strong><span>Shared files</span></span></div></section>

  <section id="projects" class="ws-section" aria-labelledby="ws-projects-heading">
    <div class="ws-section-heading"><div><span class="ws-kicker">01 / FROM IDEA TO DONE</span><h2 id="ws-projects-heading">Projects</h2></div>{% if not can_write %}<span class="ws-read-only">{{ ui.icon('lock', 13) }}Read-only access</span>{% endif %}</div>
    {% if can_write %}<details class="ws-new-project"><summary class="button">{{ ui.icon('plus', 17) }}New project</summary><form class="stack ws-form ws-inline-form" action="{{ team_path }}/projects" method="post"><input type="hidden" name="_token" value="{{ token }}"><label>Project title<input name="title" required maxlength="160" placeholder="Give the next idea a name"></label><button class="button">Create project</button></form></details>{% endif %}
    <div class="ws-board">{% for status, label in status_names %}{% set column = projects|filter(project => project.status == status) %}<section class="ws-board-column ws-column-{{ status }}" aria-labelledby="ws-column-{{ status }}"><div class="ws-column-heading"><h3 id="ws-column-{{ status }}"><span class="ws-status-dot"></span>{{ label }}</h3><span>{{ column|length }}</span></div><div class="ws-project-list">{% for project in column %}<article class="ws-project"><span class="ws-project-mark">{{ ui.icon(status == 'done' ? 'check' : 'grid', 17) }}</span><h4>{{ project.title }}</h4><span class="ws-project-status">{{ label }}</span>{% if can_write %}<details class="ws-project-edit"><summary>Edit project</summary><form class="stack ws-form" action="{{ team_path }}/projects/{{ project.id|url_encode }}" method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ project.version }}"><label>Title<input name="title" required maxlength="160" value="{{ project.title }}"></label><label>Status<select name="status">{% for value, name in status_names %}<option value="{{ value }}"{% if value == project.status %} selected{% endif %}>{{ name }}</option>{% endfor %}</select></label><button class="button secondary">Save changes</button></form><details class="ws-danger-disclosure"><summary>Delete project</summary><form action="{{ team_path }}/projects/{{ project.id|url_encode }}/delete" method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ project.version }}"><p>Delete this project permanently?</p><button class="button danger">Delete project</button></form></details></details>{% endif %}</article>{% else %}<div class="ws-board-empty"><span>+</span><p>{{ status == 'planned' ? 'The next idea starts here.' : (status == 'active' ? 'A little room to make progress.' : 'Good work will find its way here.') }}</p></div>{% endfor %}</div></section>{% endfor %}</div>
  </section>

  <div class="ws-detail-grid">
  <section id="members" class="ws-section ws-panel" aria-labelledby="ws-members-heading"><div class="ws-section-heading"><div><span class="ws-kicker">02 / BETTER TOGETHER</span><h2 id="ws-members-heading">Your people</h2></div><span class="ws-small-count">{{ members|length }}</span></div>
    <div class="ws-members">{% for member in members %}<article class="ws-member"><span class="ws-member-avatar">{{ member.name|slice(0,1)|upper }}</span><div class="ws-member-details"><h3>{{ member.name }}{% if member.user_id == user.id %}<span class="ws-you">You</span>{% endif %}</h3><span class="ws-member-role">{{ role_names[member.role]|default(member.role) }}</span></div>{% if role == 'owner' and member.role != 'owner' %}<details class="ws-member-actions"><summary>Manage</summary><form class="stack ws-form" action="{{ team_path }}/members/{{ member.user_id }}/role" method="post"><input type="hidden" name="_token" value="{{ token }}"><label>Team role<select name="role">{% for value in ['admin','member','viewer'] %}<option value="{{ value }}"{% if value == member.role %} selected{% endif %}>{{ role_names[value] }}</option>{% endfor %}</select></label><button class="button secondary">Update role</button></form><form action="{{ team_path }}/members/{{ member.user_id }}/remove" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="ws-text-danger">Remove from team</button></form></details>{% elseif role == 'admin' and member.role in ['member','viewer'] %}<details class="ws-member-actions"><summary>Manage</summary><form action="{{ team_path }}/members/{{ member.user_id }}/remove" method="post"><input type="hidden" name="_token" value="{{ token }}"><p class="form-hint">Remove this person from the organization?</p><button class="button danger">Remove from team</button></form></details>{% endif %}</article>{% else %}<p class="ws-empty-copy">No members to show.</p>{% endfor %}</div>
    {% if can_manage %}<details class="ws-panel-disclosure"><summary>{{ ui.icon('plus', 15) }}Invite a teammate</summary><form class="stack ws-form" action="{{ team_path }}/invites" method="post"><input type="hidden" name="_token" value="{{ token }}"><label>Email address<input type="email" name="email" required maxlength="190" autocomplete="email" placeholder="teammate@example.com"></label><label>Invite as<select name="role"><option value="member">Member — projects and files</option><option value="viewer">Viewer — read-only access</option>{% if role == 'owner' %}<option value="admin">Administrator — team management</option>{% endif %}</select></label><button class="button">Create invitation</button></form></details>{% endif %}
    {% if role == 'owner' and members|length > 1 %}<details class="ws-panel-disclosure ws-owner-transfer"><summary>Transfer ownership</summary><p class="form-hint">The selected person becomes owner. Your role changes to administrator.</p><form class="stack ws-form" action="{{ team_path }}/transfer" method="post"><input type="hidden" name="_token" value="{{ token }}"><label>New owner<select name="user_id" required><option value="">Choose a team member</option>{% for member in members %}{% if member.user_id != user.id %}<option value="{{ member.user_id }}">{{ member.name }} — {{ role_names[member.role]|default(member.role) }}</option>{% endif %}{% endfor %}</select></label><button class="button danger">Transfer ownership</button></form></details>{% endif %}
  </section>

  <section id="files" class="ws-section ws-panel" aria-labelledby="ws-files-heading"><div class="ws-section-heading"><div><span class="ws-kicker">03 / THE USEFUL DETAILS</span><h2 id="ws-files-heading">Shared files</h2></div><span class="ws-small-count">{{ files|length }}</span></div><div class="ws-files">{% for file in files %}<article class="ws-file"><span class="ws-file-icon">{{ ui.icon('file', 21) }}</span><div class="ws-file-details"><a class="ws-file-name" href="{{ team_path }}/files/{{ file.id|url_encode }}">{{ file.name }}</a><span class="ws-file-size">{% if file.bytes >= 1048576 %}{{ (file.bytes / 1048576)|number_format(1) }} MB{% elseif file.bytes >= 1024 %}{{ (file.bytes / 1024)|number_format(1) }} KB{% else %}{{ file.bytes }} B{% endif %}</span></div><a class="ws-icon-link" href="{{ team_path }}/files/{{ file.id|url_encode }}" aria-label="Download {{ file.name }}">{{ ui.icon('download', 18) }}</a>{% if can_write %}<details class="ws-file-remove"><summary>Delete</summary><form method="post" action="{{ team_path }}/files/{{ file.id|url_encode }}/delete"><input type="hidden" name="_token" value="{{ token }}"><p>Delete this shared file permanently?</p><button class="button danger">Delete file</button></form></details>{% endif %}</article>{% else %}<div class="ws-empty-panel"><span>{{ ui.icon('file', 28) }}</span><h3>A place for the details.</h3><p>Shared documents and images will appear here.</p></div>{% endfor %}</div>{% if can_write %}<details class="ws-panel-disclosure"><summary>{{ ui.icon('plus', 15) }}Upload a file</summary><form class="stack ws-form" action="{{ team_path }}/files" method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><label>Choose a file<input name="file" type="file" required></label><label class="ws-checkbox"><input name="image" type="checkbox" value="1">Image upload</label><p class="form-hint">Enable image upload to check the file as an image.</p><button class="button">Upload file</button></form></details>{% endif %}</section>
  </div>
  {% else %}
  <section class="ws-welcome"><div class="ws-welcome-symbol">{{ ui.icon('grid', 38) }}</div><p class="ws-kicker">A TEAM. A PLAN. A BEGINNING.</p><h2>Give the work a home.</h2><p>Keep your projects, teammates, and shared files together in an organization.</p>{% if teams %}<div class="ws-organization-grid">{% for team in teams %}<a href="/workspace/team/{{ team.id|url_encode }}"><span class="ws-team-avatar">{{ team.name|slice(0,1)|upper }}</span><div><strong>{{ team.name }}</strong><span>{{ role_names[team.role]|default(team.role) }}</span></div>{{ ui.icon('arrow', 17) }}</a>{% endfor %}</div>{% else %}<form class="stack ws-form" method="post" action="/workspace/teams"><input type="hidden" name="_token" value="{{ token }}"><label>Organization name<input name="name" required maxlength="80" autocomplete="organization" placeholder="Your next chapter"></label><button class="button">Create your first organization {{ ui.icon('arrow', 16) }}</button></form>{% endif %}</section>
  {% endif %}

  <section id="inbox" class="ws-section ws-inbox" aria-labelledby="ws-inbox-heading"><div class="ws-section-heading"><div><span class="ws-kicker">STAY IN THE LOOP</span><h2 id="ws-inbox-heading">Your inbox</h2></div>{% if unread %}<span class="ws-inbox-count">{{ unread }} unread</span>{% endif %}</div>{% for item in inbox %}<article class="ws-notification{% if not item.read_at %} ws-notification-unread{% endif %}"><span class="ws-notification-dot"></span><div><h3>{{ item.subject }}</h3><p>{{ item.body }}</p>{% if item.url and item.url starts with '/' and not (item.url starts with '//') %}<a class="ws-notification-link" href="{{ item.url }}">View details {{ ui.icon('arrow', 13) }}</a>{% endif %}</div>{% if not item.read_at %}<form action="/workspace/notifications/{{ item.id|url_encode }}/read" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="button secondary">Mark as read</button></form>{% else %}<span class="ws-read-badge">Read {{ ui.icon('check', 13) }}</span>{% endif %}</article>{% else %}<div class="ws-inbox-empty">{{ ui.icon('inbox', 23) }}<p>All clear. New updates will appear here.</p></div>{% endfor %}</section>
  <footer class="ws-footer"><span>Built with Elang · Clear steps. Shared progress.</span><a href="/security">Your account security {{ ui.icon('arrow', 13) }}</a></footer>
</main>
</div>
</body></html>
