<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Content Studio — Elang</title><link rel="stylesheet" href="/_elang/assets/ui.css?v={{ elang_asset_version }}"></head><body><header class="product-header"><a class="product-brand" href="/admin">e<span>.</span> <strong>Content Studio</strong></a><nav><a href="/">View website ↗</a><a href="/dashboard">Account</a><a href="/security">Security</a><a href="/admin/integrations">Package publishing</a><a href="/operations">Operations</a><form action="/logout" method="post"><input type="hidden" name="_token" value="{{ token }}"><button class="link-button">Sign out</button></form></nav></header><main class="wide-shell"><p class="eyebrow">ELANG / EDITORIAL WORKSPACE</p><div class="toolbar"><h1>{{ mode == 'index' ? 'Make the next step clearer.' : 'A useful page starts here.' }}</h1><div class="toolbar-actions"><a class="button secondary" href="/admin">All content</a><a class="button" href="/admin/edit">Create a page →</a></div></div>{% if message %}<div class="notice" role="status">{{ message }}</div>{% endif %}{% if errors %}<div class="notice error" role="alert"><ul>{% for field,messages in errors %}{% for message in messages %}<li>{{ field }}: {{ message }}</li>{% endfor %}{% endfor %}</ul></div>{% endif %}
{% if mode == 'index' %}<section class="panel"><h2>Your editorial changes</h2><p class="form-hint">Drafts stay private. Publishing updates the public page, navigation, search, Markdown, and sitemap from the same content source.</p><div class="table-scroll"><table><thead><tr><th>Page</th><th>Section</th><th>State</th><th>Revision</th></tr></thead><tbody>{% for item in pages %}<tr><td><a href="/admin/edit?section={{ item.section|url_encode }}&slug={{ item.slug|url_encode }}&locale={{ item.locale }}">{{ item.draft_title }}</a></td><td>{{ item.locale|upper }} / {{ item.section }}</td><td>{{ item.published_at ? 'Published / draft available' : 'Draft only' }}</td><td>{{ item.revision }}</td></tr>{% else %}<tr><td colspan="4">No editorial changes yet. Choose a source page below or create a new one.</td></tr>{% endfor %}</tbody></table></div></section><section class="panel"><h2>Published website catalog</h2><div class="table-scroll"><table><thead><tr><th>Page</th><th>Section</th><th>Actions</th></tr></thead><tbody>{% for section,items in catalog %}{% for slug,title in items %}<tr><td>{{ title }}</td><td>{{ section }}</td><td><a href="/admin/edit?section={{ section|url_encode }}&slug={{ slug|url_encode }}&locale={{ content_locale }}">Edit</a> · <a href="/{{ section }}/{{ slug }}">View ↗</a></td></tr>{% endfor %}{% endfor %}</tbody></table></div></section>
{% elseif record %}<div class="split-layout"><aside><section class="panel"><h2>Writing checklist</h2><p class="form-hint">Explain the goal and prerequisites. Include complete commands, expected results, likely errors, and a useful next step.</p><p class="form-hint">Use one # heading and ## for sections. Add descriptive links to related lessons. Write the page in its selected content language.</p></section><section class="panel"><h2>Revision history</h2>{% for revision in history %}<div class="stack"><strong>#{{ revision.revision }} · {{ revision.action }}</strong><p class="form-hint">{{ revision.created_at|date('Y-m-d H:i') }}</p><form method="post" action="/admin/restore"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="section" value="{{ record.section }}"><input type="hidden" name="slug" value="{{ record.slug }}"><input type="hidden" name="revision" value="{{ revision.revision }}"><input type="hidden" name="locale" value="{{ record.locale }}"><input type="hidden" name="expected" value="{{ record.revision }}"><button class="button secondary">Restore as draft</button></form></div><hr>{% else %}<p class="form-hint">The first save creates a revision.</p>{% endfor %}</section></aside><div><form class="panel stack" method="post" action="/admin/save"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="revision" value="{{ record.revision }}"><label>Content language<select name="locale">{% for code,name in languages %}<option value="{{ code }}"{% if code == record.locale %} selected{% endif %}>{{ name }}</option>{% endfor %}</select></label><div class="field-row"><label>Section<select name="section">{% for section in sections %}<option value="{{ section }}"{% if section == record.section %} selected{% endif %}>{{ section }}</option>{% endfor %}</select></label><label>URL slug<input name="slug" value="{{ record.slug }}" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120" placeholder="a-clear-next-step"></label></div><label>Page title<input name="title" value="{{ record.draft_title }}" required maxlength="160"></label><label>Search description<input name="description" value="{{ record.draft_description }}" required minlength="40" maxlength="200"></label><label>Article Markdown<textarea class="editor-area" name="markdown" required maxlength="180000">{{ record.draft_markdown }}</textarea></label><div class="toolbar-actions"><button class="button secondary" name="action" value="draft">Save draft</button><button class="button secondary" name="action" value="preview">Preview</button><button class="button" name="action" value="publish">Publish page →</button></div><p class="form-hint">Publishing makes this article publicly readable. Restoring an old revision creates a draft for review.</p></form>{% if preview %}<section class="panel"><h2>Unpublished preview</h2><article class="prose-content">{{ preview|raw }}</article></section>{% endif %}</div></div>{% endif %}</main><footer class="product-footer">Content changes are revisioned in private storage. Application source remains outside the public web root.</footer></body></html>
