{% extends 'base.twig' %}{% block content %}<section class="container page-intro"><p class="eyebrow">LEARN BY BUILDING</p><h1>One small step.<br><span class="serif">A whole new possibility.</span></h1><p>You don’t need to know the whole framework to start.<br>Six focused lessons. Real code. A clear path forward.</p><div class="intro-meta"><span>6 practical lessons</span><span>PHP fundamentals recommended</span><span>v0.1 preview</span></div></section><section class="container curriculum"><div class="section-heading"><h2>Your learning path</h2><span class="muted small">Start at the beginning. Build at your pace.</span></div>{% for slug, lesson in lessons %}<a class="lesson-row" href="/learn/{{ slug }}"><span class="lesson-number">{{ lesson[2] }}</span><div><h3>{{ lesson[0] }}</h3><p>{{ lesson[1] }}</p></div><span class="lesson-duration">~ {{ lesson[3] }}</span><span class="row-arrow">↗</span></a>{% endfor %}<div class="callout-row"><div><h3>Already know your way around PHP?</h3><p>Jump into the documentation and find exactly what you need.</p></div><a class="button secondary" href="/docs/v0.1/introduction">Open documentation →</a></div></section>{% endblock %}
