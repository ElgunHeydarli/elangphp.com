{% extends 'base.twig' %}
{% block head %}{% if document.section == 'docs/v0.1' %}<link rel="alternate" type="text/markdown" href="{{ path }}.md">{% endif %}{% endblock %}
{% block content %}<div class="docs-shell"><aside class="docs-sidebar"><a class="docs-version" href="/updates"><span class="status-dot"></span>v0.1 <span>Development preview ↗</span></a><button class="docs-menu-toggle button secondary" aria-expanded="false" aria-controls="docs-navigation">Browse {{ active == 'docs' ? 'documentation' : active }} ↓</button><nav id="docs-navigation" aria-label="Section navigation">{% for group, items in groups %}<div class="docs-nav-group"><h2>{{ group }}</h2>{% for slug, label in items %}<a href="/{{ document.section }}/{{ slug }}"{% if slug == document.slug %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</div>{% endfor %}</nav><a class="docs-sidebar-reference" href="/api-reference">API reference ↗</a></aside><div class="docs-main"><nav class="doc-breadcrumb" aria-label="Breadcrumb">{% for crumb in breadcrumbs %}{% if not loop.first %}<span>/</span>{% endif %}{% if loop.last %}<span aria-current="page">{{ crumb.name }}</span>{% else %}<a href="{{ crumb.url }}">{{ crumb.name }}</a>{% endif %}{% endfor %}</nav><div class="preview-banner"><span class="status-dot"></span> You’re reading the v0.1 development preview. APIs may change.</div><div class="document-meta"><span>~ {{ document.reading_minutes }} min read</span><span>Updated {{ document.modified }}</span>{% if document.section == 'learn' %}<button class="lesson-complete" data-lesson-id="{{ document.slug }}" aria-pressed="false">Mark lesson complete</button>{% endif %}</div><article class="prose">{{ document.html|raw }}</article><div class="document-help"><strong>Need a hand?</strong><p>Check the <a href="/docs/v0.1/troubleshooting">troubleshooting guide</a>, look up a term in the <a href="/docs/v0.1/glossary">glossary</a>, or work through the <a href="/learn/build-a-task-board">complete task board project</a>.</p></div><div class="doc-actions"><a href="https://github.com/ElgunHeydarli/elangphp.com/blob/main/content/{{ document.section }}/{{ document.slug }}.md">Edit this page on GitHub ↗</a>{% if document.section == 'docs/v0.1' %}<a href="{{ path }}.md">View as Markdown ↗</a>{% endif %}</div><nav class="doc-pagination" aria-label="Document pages">{% if document.previous %}<a href="{{ document.previous.url }}"><span>← Previous</span><strong>{{ document.previous.title }}</strong></a>{% else %}<span></span>{% endif %}{% if document.next %}<a href="{{ document.next.url }}"><span>Next →</span><strong>{{ document.next.title }}</strong></a>{% endif %}</nav></div><aside class="docs-toc"><span class="small-label">ON THIS PAGE</span><nav aria-label="On this page">{% for heading in document.toc %}<a href="#{{ heading.id }}">{{ heading.title }}</a>{% endfor %}</nav><a class="toc-help" href="/community">Something unclear?<br><strong>Help improve the docs ↗</strong></a></aside></div>{% endblock %}
