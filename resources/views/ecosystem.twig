{% extends 'base.twig' %}{% block content %}<section class="container page-intro"><p class="eyebrow">STANDING ON GOOD FOUNDATIONS</p><h1>Familiar tools.<br><span class="serif">Thoughtfully connected.</span></h1><p>Elang brings established open-source components together.<br>A clear application API, backed by libraries you can inspect.</p><div class="intro-meta"><span>Managed with Composer</span><span>Versions from the actual lock file</span></div></section><section class="container package-section"><div class="section-heading"><h2>Official Elang packages</h2><a class="inline-link" href="/docs/v0.1/installation">Install from your terminal →</a></div><div class="package-grid first-party-packages">{% for package in [['elang/framework','Framework core','The HTTP kernel, router, services, and application API.'],['elang/elang','Application skeleton','A clean PHP application with Composer-driven setup.'],['elang/installer','Terminal installer','Create applications with elang new after one-time setup.'],['elang/task-board','Learning starter','A complete task board with forms, validation, sessions, and CSRF.']] %}<a class="package-card" href="/docs/v0.1/installation"><div><span class="package-category">{{ package[1] }}</span><span class="package-version">{{ version }}</span></div><h3>{{ package[0] }} ↗</h3><p>{{ package[2] }}</p></a>{% endfor %}</div><div class="section-heading"><h2>The building blocks</h2><a class="inline-link" href="https://github.com/ElgunHeydarli/elangphp.com/blob/main/composer.json">View composer.json ↗</a></div><div class="package-grid">{% for package in packages %}<a class="package-card" href="{{ package[3] }}"><div><span class="package-category">{{ package[1] }}</span><span class="package-version">{{ versions[package[0]]|default('See lock file') }}</span></div><h3>{{ package[0] }} <span>↗</span></h3><p>{{ package[2] }}</p></a>{% endfor %}</div><div class="callout-row"><div><h3>One framework. Room for your own tools.</h3><p>Install additional Composer packages and register their services through a provider.</p></div><a class="button secondary" href="/docs/v0.1/container">Explore service providers →</a></div></section>{% endblock %}
