'Http\\Resource': ['src/Http/Resource.php', ['toArray(Request $request): array', 'toResponse(Request $request): Response', 'collection(iterable $items): ResourceCollection']],
'Http\\Client\\Client': ['src/Http/Client/Client.php', ['request(): PendingRequest', 'baseUrl(string $url): PendingRequest', 'withToken(string $token, string $scheme = "Bearer"): PendingRequest', 'get(string $url, array $query = []): Response', 'post(string $url, array $data = []): Response']],
