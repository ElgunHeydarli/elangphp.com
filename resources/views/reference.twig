{% extends 'base.twig' %}{% block content %}<section class="container page-intro"><p class="eyebrow">THE PUBLIC SURFACE</p><h1>A small API.<br><span class="serif">A useful reference.</span></h1><p>The core entry points available in the v0.1 preview.<br>For complete type signatures, follow the linked source.</p></section><section class="container api-reference">{% set classes = {
'Application': ['src/Application.php', ['create(string $basePath): Application', 'provider(ServiceProvider $provider): self', 'middleware(string ...$classes): self', 'handle(Request $request): Response', 'run(): void']],
'Routing\\Router': ['src/Routing/Router.php', ['get(string $path, callable|array|string $handler, ?string $name = null): Route', 'post / put / patch / delete: same arguments as get', 'group(string $prefix, array $middleware, callable $routes): void', 'url(string $name, array $parameters = []): string']],
'Container\\Container': ['src/Container/Container.php', ['bind(string $id, Closure|string $factory, bool $shared = false): void', 'singleton(string $id, Closure|string $factory): void', 'instance(string $id, mixed $instance): void', 'get(string $id): mixed', 'has(string $id): bool']],
'Http\\Response': ['src/Http/Response.php', ['json(mixed $data, int $status = 200, array $headers = []): JsonResponse', 'html(string $html, int $status = 200): Response', 'redirect(string $path, int $status = 302): RedirectResponse']],
'Database\\Database': ['src/Database/Database.php', ['connection(): Doctrine DBAL Connection', 'table(string $table): Doctrine DBAL QueryBuilder', 'transaction(callable $callback): mixed']],
'Validation\\Validator': ['src/Validation/Validator.php', ['validate(array $data, array $rules): array']],
'View\\View': ['src/View/View.php', ['render(string $template, array $data = [], int $status = 200): Response', 'engine(): Twig Environment']],
'Security\\Password': ['src/Security/Password.php', ['hash(string $password): string', 'verify(string $password, string $hash): bool', 'needsRehash(string $hash): bool']],
'Security\\Encryption': ['src/Security/Encryption.php', ['encrypt(string $value): string', 'decrypt(string $value): string']],
'Security\\Csrf': ['src/Security/Csrf.php', ['token(Request $request): string', 'verify(Request $request, string $token): bool']]
} %}{% for name, info in classes %}<article class="reference-row"><div><h2>Elang\{{ name }}</h2><a href="https://github.com/ElgunHeydarli/elangphp.com/blob/main/{{ info[0] }}">View source ↗</a></div><ul>{% for method in info[1] %}<li><code>{{ method }}</code></li>{% endfor %}</ul></article>{% endfor %}</section>{% endblock %}
