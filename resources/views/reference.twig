'Orm\\Orm': ['src/Orm/Orm.php', ['manager(): Doctrine ORM EntityManager', 'transaction(callable $callback): mixed', 'softDelete(SoftDeletable $entity): void', 'restore(SoftDeletable $entity): void', 'withDeleted(callable $callback): mixed', 'reset(): void', 'clearMetadataCache(): void']],
