{% extends 'base.twig' %}{% block content %}<section class="container page-intro"><p class="eyebrow">IDEAS YOU CAN RUN</p><h1>Small examples.<br><span class="serif">Useful beginnings.</span></h1><p>Focused patterns for the things you’ll build first.<br>Read the code, make a request, then make it your own.</p></section><section class="container example-grid">{% for slug, example in examples %}<a class="example-card" href="/examples/{{ slug }}"><span class="tag">{{ example[2] }}</span><div class="example-visual" aria-hidden="true">{% if loop.index == 1 %}<span>GET</span><code>/hello/{name}</code>{% elseif loop.index == 2 %}<span>422 → 200</span><code>validate($data)</code>{% else %}<span>↗ DBAL</span><code>table('examples')</code>{% endif %}</div><h2>{{ example[0] }}</h2><p>{{ example[1] }}</p><span class="inline-link">Explore example ↗</span></a>{% endfor %}</section><div class="container callout-row"><div><h3>See the request and the response.</h3><p>The homepage playground calls a real Elang backend.</p></div><a class="button secondary" href="/#playground-run">Try the live playground →</a></div>{% endblock %}
